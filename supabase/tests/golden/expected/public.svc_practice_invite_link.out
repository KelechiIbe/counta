[{"svc_practice_invite_link": {"to": "new.client@example.test", "link": "https://counta-taxstreem.netlify.app/practice/join?t=pc_<hex>", "greet": "New", "lines": ["Golden Partners would like to keep your books and handle your tax in Counta, for New Client Ltd.", "When you accept, their accountants get an Accountant's place in your business: they keep the books and prepare tax returns, and never move money. You choose which business, and you can end it at any time.", "Use the button to sign in, or sign up if you are new to Counta."], "button": "See the invitation", "heading": "Connect your business to Golden Partners", "subject": "Golden Partners invites you to work together on Counta", "reply_to": "partner@example.test", "from_name": "Golden Partners"}}]

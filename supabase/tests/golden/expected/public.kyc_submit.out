[{"?column?": {"name": "Golden Foods Ltd", "compliance": {"next": {"id": "cac_document", "ok": false, "text": "Upload your latest CAC status report or your application for registration, so your directors, owners and share capital are on record.", "label": "CAC records on file", "action": "cac_document"}, "items": [{"id": "cac_registered", "ok": false, "text": "Register the business with the Corporate Affairs Commission: a business name for a sole trader, a company for a limited company. Banks, big customers and the NRS all ask for it.", "label": "Registered with CAC", "action": null}, {"id": "tax_id", "ok": true, "text": "Your Tax ID is on record.", "label": "Has a Tax ID", "action": "settings"}, {"id": "cac_document", "ok": false, "text": "Upload your latest CAC status report or your application for registration, so your directors, owners and share capital are on record.", "label": "CAC records on file", "action": "cac_document"}, {"id": "owners_on_record", "ok": false, "text": "CAC shows no directors or owners for the business. Update the record on the CAC portal: banks and the NRS check it.", "label": "Directors and owners on record", "action": null}, {"id": "vat_filing", "ok": true, "text": "VAT is filed every month, or the business is below the ₦100m small company limit.", "label": "VAT handled", "action": "vat"}, {"id": "wht_filing", "ok": false, "text": "Deduct withholding tax from qualifying payments to suppliers and pay it over by the 21st of the next month. Counta works it out on every bill.", "label": "Withholding tax handled", "action": "wht"}, {"id": "cit_filing", "ok": true, "text": "The personal income tax returns for the business's profit are filed.", "label": "Income tax returns filed", "action": "pit"}, {"id": "business_account", "ok": true, "text": "Customers pay into an account in the business's name.", "label": "Paid into a business account", "action": "account_number"}, {"id": "bank_records", "ok": false, "text": "Connect your bank, or upload a bank statement, so every naira in and out is in your books.", "label": "Bank records in the books", "action": "bank"}, {"id": "books_current", "ok": true, "text": "Your sales are recorded in Counta.", "label": "Sales recorded", "action": "first_sale"}], "score": 5, "total": 10}}}]

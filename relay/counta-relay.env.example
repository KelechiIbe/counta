# /etc/counta-relay.env  (chmod 600, owned by root)
# The same value goes into Counta's admin portal as FLW_RELAY_SECRET. At least 32 characters; make one with:
#   openssl rand -hex 32
RELAY_SECRET=
# Optional: keep Flutterwave's secret key here instead of letting it travel with each request.
# RELAY_FLW_KEY=
